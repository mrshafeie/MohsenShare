<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MohsenShare.Maui.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="MohsenShare"
    BackgroundColor="#F4F7FB">

    <Grid Padding="24"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="24">

        <VerticalStackLayout Grid.Row="0"
                             Spacing="8"
                             VerticalOptions="Center">

            <Label Text="MohsenShare"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#172554" />

            <Label Text="انتقال فایل، ساده و مستقیم"
                   FontSize="16"
                   TextColor="#64748B" />

            <Label Text="بدون نیاز به اینترنت"
                   FontSize="13"
                   TextColor="#64748B" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1"
                             Spacing="18"
                             VerticalOptions="Center">

            <Border BackgroundColor="White"
                    Stroke="#DBEAFE"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 22"
                    Padding="20">

                <VerticalStackLayout Spacing="14">

                    <Label Text="ارسال فایل"
                           FontSize="23"
                           FontAttributes="Bold"
                           TextColor="#172554" />

                    <Label Text="فایل را انتخاب کن و به دستگاه مقصد بفرست."
                           FontSize="14"
                           TextColor="#64748B" />

                    <Button Text="ارسال فایل"
                            Clicked="OnSendClicked"
                            HeightRequest="58"
                            CornerRadius="16"
                            FontSize="17"
                            FontAttributes="Bold"
                            BackgroundColor="#2563EB"
                            TextColor="White" />

                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#D1FAE5"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 22"
                    Padding="20">

                <VerticalStackLayout Spacing="14">

                    <Label Text="دریافت فایل"
                           FontSize="23"
                           FontAttributes="Bold"
                           TextColor="#172554" />

                    <Label Text="دستگاهت را برای دریافت فایل آماده کن."
                           FontSize="14"
                           TextColor="#64748B" />

                    <Button Text="دریافت فایل"
                            Clicked="OnReceiveClicked"
                            HeightRequest="58"
                            CornerRadius="16"
                            FontSize="17"
                            FontAttributes="Bold"
                            BackgroundColor="#059669"
                            TextColor="White" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

        <Label Grid.Row="2"
               Text="MohsenShare · انتقال محلی و مستقیم"
               FontSize="12"
               TextColor="#94A3B8"
               HorizontalTextAlignment="Center" />

    </Grid>
</ContentPage>
