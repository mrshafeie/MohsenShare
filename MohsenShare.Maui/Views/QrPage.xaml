<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MohsenShare.Maui.Views.QrPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
    Title="دریافت فایل"
    BackgroundColor="#F4F7FB">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="18"
            VerticalOptions="Center">

            <Label
                Text="دریافت فایل"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                TextColor="#172554" />

            <Label
                Text="با دستگاه فرستنده این کد را اسکن کن"
                FontSize="15"
                HorizontalTextAlignment="Center"
                TextColor="#64748B" />

            <Border
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 20"
                Padding="16"
                HorizontalOptions="Center">

                <zxing:BarcodeGeneratorView
                    x:Name="QrImage"
                    HeightRequest="260"
                    WidthRequest="260"
                    Format="QrCode"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Label
                Text="آدرس دستگاه"
                FontAttributes="Bold"
                TextColor="#172554" />

            <Label
                x:Name="AddressLabel"
                FontSize="16"
                HorizontalTextAlignment="Center"
                TextColor="#2563EB" />

            <Label
                Text="کد اتصال"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                TextColor="#172554" />

            <Label
                x:Name="TokenLabel"
                FontSize="12"
                HorizontalTextAlignment="Center"
                TextColor="#475569" />

            <Label
                Text="فایل‌های دریافتی در محل ذخیره تعیین‌شده توسط برنامه قرار می‌گیرند."
                FontSize="13"
                HorizontalTextAlignment="Center"
                TextColor="#64748B" />

            <Button
                Text="توقف دریافت"
                Clicked="OnStopClicked"
                BackgroundColor="#DC2626"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
