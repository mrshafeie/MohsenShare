<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MohsenShare.Maui.Views.DeviceSelectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="انتخاب دستگاه"
    BackgroundColor="#F4F7FB">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,Auto,*,Auto"
          RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="5">
            <Label Text="ارسال فایل"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#172554" />

            <Label Text="اطلاعات اتصال را از صفحه دریافت دستگاه مقصد بردار."
                   FontSize="14"
                   TextColor="#64748B" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Padding="12"
                BackgroundColor="White"
                Stroke="#DBEAFE"
                StrokeShape="RoundRectangle 14">

            <HorizontalStackLayout Spacing="10">
                <ActivityIndicator IsRunning="{Binding IsScanning}"
                                   IsVisible="{Binding IsScanning}"
                                   Color="#2563EB"
                                   VerticalOptions="Center" />

                <Label Text="{Binding Status}"
                       FontSize="13"
                       TextColor="#475569"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <Border Grid.Row="2"
                Padding="15"
                BackgroundColor="White"
                Stroke="#DCE5F0"
                StrokeShape="RoundRectangle 18">

            <VerticalStackLayout Spacing="10">

                <Label Text="اتصال مستقیم"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#172554" />

                <Entry x:Name="ManualIpEntry"
                       Placeholder="آدرس IP، مثال: 192.168.137.1"
                       Keyboard="Text"
                       ClearButtonVisibility="WhileEditing"
                       FlowDirection="LeftToRight"
                       HorizontalTextAlignment="Start"
                       BackgroundColor="#F8FAFC"
                       TextColor="#0F172A"
                       PlaceholderColor="#94A3B8"
                       HeightRequest="46" />

                <Entry x:Name="ManualPortEntry"
                       Placeholder="پورت TCP نمایش‌داده‌شده در صفحه دریافت"
                       Keyboard="Numeric"
                       ClearButtonVisibility="WhileEditing"
                       FlowDirection="LeftToRight"
                       HorizontalTextAlignment="Start"
                       BackgroundColor="#F8FAFC"
                       TextColor="#0F172A"
                       PlaceholderColor="#94A3B8"
                       HeightRequest="46" />

                <Entry x:Name="ManualTokenEntry"
                       Placeholder="کد اتصال نمایش‌داده‌شده در صفحه دریافت"
                       Keyboard="Text"
                       IsSpellCheckEnabled="False"
                       IsTextPredictionEnabled="False"
                       ClearButtonVisibility="WhileEditing"
                       FlowDirection="LeftToRight"
                       HorizontalTextAlignment="Start"
                       BackgroundColor="#F8FAFC"
                       TextColor="#0F172A"
                       PlaceholderColor="#94A3B8"
                       HeightRequest="46" />

                <Button x:Name="ManualSendButton"
                        Text="انتخاب فایل و ارسال"
                        Clicked="OnManualSendClicked"
                        HeightRequest="50"
                        CornerRadius="13"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontSize="15"
                        FontAttributes="Bold" />

            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Devices}"
                        SelectionMode="Single"
                        SelectionChanged="OnDeviceSelected">

            <CollectionView.Header>
                <Label Text="دستگاه‌های پیدا‌شده در شبکه"
                       Margin="0,0,0,10"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#334155" />
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="12"
                                     Spacing="8"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">

                    <Label Text="هنوز دستگاهی پیدا نشده است"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#334155"
                           HorizontalTextAlignment="Center" />

                    <Label Text="می‌توانی IP دستگاه را دستی وارد کنی."
                           FontSize="13"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="13"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 14">

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12">

                            <Border WidthRequest="44"
                                    HeightRequest="44"
                                    BackgroundColor="#EFF6FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">

                                <Label Text="💻"
                                       FontSize="22"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="3">

                                <Label Text="{Binding Name}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#172554" />

                                <Label Text="{Binding Platform}"
                                       FontSize="12"
                                       TextColor="#64748B" />

                                <Label Text="{Binding IpAddress}"
                                       FontSize="12"
                                       TextColor="#2563EB" />
                            </VerticalStackLayout>

                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="26"
                                   TextColor="#2563EB"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="4"
                Text="لغو"
                Clicked="OnCancelClicked"
                HeightRequest="48"
                CornerRadius="13"
                BackgroundColor="#475569"
                TextColor="White"
                FontSize="15"
                FontAttributes="Bold" />

    </Grid>
</ContentPage>
